    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --experimental-test-module-mocks --test tests/*.test.mjs && npm run test:proto",
    "typecheck": "tsc --noEmit",
